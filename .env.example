# Copy to .env.local (never commit). Vite reads VITE_* at build time.
# Supabase (Auth + main/user recordings) — paste from supabase.com > Project Settings > API
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# FastAPI backend (stays on localhost for now — no cloud hosting per locked decision)
# Frontend uses these instead of hardcoded http://localhost:8000
VITE_API_URL=http://localhost:8000/api/db
VITE_API_BASE=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/stream

# After `vercel deploy`, set the same vars in Vercel Dashboard > Settings > Environment
# Variables, then add the Vercel URL to Supabase Dashboard > Authentication > URL
# Configuration > Redirect URLs.
